# Provider selection is configuration, not Loren identity.
LOREN_BRAIN_PROVIDER=Ollama

# Set locally or in a secret store. Never commit real values.
OLLAMA_API_KEY=
OPENAI_API_KEY=

# Production Ollama adapter defaults. Override only with trusted configuration.
LOREN_OLLAMA_MODEL=gpt-oss:120b
LOREN_OLLAMA_ENDPOINT=https://ollama.com/api/chat

# Internal M2 run endpoint is OFF by default and may only be enabled in Development.
LOREN_ENABLE_DEVELOPMENT_RUN_ENDPOINT=false
ASPNETCORE_ENVIRONMENT=Development
