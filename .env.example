# Provider selection is configuration, not Loren identity.
LOREN_BRAIN_PROVIDER=Ollama

# Set locally or in a secret store. Never commit real values.
OLLAMA_API_KEY=
OPENAI_API_KEY=
LOREN_OWNER_PASSWORD=

# Production Ollama adapter defaults. Override only with trusted configuration.
LOREN_OLLAMA_MODEL=gpt-oss:120b
LOREN_OLLAMA_ENDPOINT=https://ollama.com/api/chat

# Optional canonical-state directory. Loren stores loren.db here and runs EF migrations at startup.
# When unset, Loren uses the OS local application-data directory under Loren/.
LOREN_DATA_DIRECTORY=

# Gate D global write posture. Only the exact value true opts the host out of read-only mode.
# Missing, false, malformed, or any other value remains fail-closed/read-only.
# M5 Slice 1 still registers no real GitHub mutation executor.
LOREN_ENABLE_WRITES=false

# Internal M2 proof endpoint is OFF by default and may only be enabled in Development.
LOREN_ENABLE_DEVELOPMENT_RUN_ENDPOINT=false
ASPNETCORE_ENVIRONMENT=Development
